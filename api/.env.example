HELPER_TOKEN=replace-with-a-long-random-token
# AI calls are server-side. The default keeps AI disabled.
AI_PROVIDER=none
THRESHOLD=0.25
# Local Ollama OpenAI-compatible endpoint and model.
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
# Cloud provider must expose an OpenAI-compatible HTTPS chat completions URL.
CLOUD_URL=https://api.openai.com/v1/chat/completions
CLOUD_API_KEY=
CLOUD_MODEL=gpt-4o-mini
# Optional: receives a JSON escalation.opened notification.
# WEBHOOK_URL=https://example.org/webhook
# Optional database location; default is api/escalations.sqlite3
# ESCALATIONS_DB=./escalations.sqlite3
# Outbound SMS alerts require Twilio credentials. Generate a key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SMS_ENCRYPTION_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
