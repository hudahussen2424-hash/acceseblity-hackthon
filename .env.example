# -----------------------------------------------------------------------------
# Learning Assistant & Course Escalations - Environment Configuration
# -----------------------------------------------------------------------------

# Secret token required in 'X-Helper-Token' header for tutor/helper endpoints
HELPER_TOKEN=replace-with-a-long-random-token

# Webhook endpoint URL: receives { event: "ticket.opened", ticketId, at } POSTs
# Test locally with requestcatcher (e.g. https://your-subdomain.requestcatcher.com/test)
WEBHOOK_URL=https://example.org/webhook

# SQLite database file path (defaults to api/escalations.sqlite3)
ESCALATIONS_DB=api/escalations.sqlite3

# Automatically purge tutor tickets and attachments after this many days (0 disables expiry)
TICKET_RETENTION_DAYS=90

# AI Q&A Provider: 'none' (pure search fallback), 'local' (Ollama), or 'cloud'
AI_PROVIDER=none

# Search similarity threshold (0.0 to 1.0; default: 0.25)
THRESHOLD=0.25

# Local Ollama OpenAI-compatible endpoint and model (used when AI_PROVIDER=local)
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Cloud OpenAI-compatible endpoint and model (used when AI_PROVIDER=cloud)
CLOUD_URL=https://api.openai.com/v1/chat/completions
CLOUD_API_KEY=
CLOUD_MODEL=gpt-4o-mini

# Telegram Bot integration (only required when running telegram profile)
TELEGRAM_BOT_TOKEN=
COURSE_BASE_URL=https://github.com/hudahussen2424-hash/acceseblity-hackthon/blob/main/

# SMS Alert Delivery (subscriber phone numbers are encrypted at rest with Fernet)
# Generate a key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SMS_ENCRYPTION_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
